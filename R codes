  }
  
  extra_rows <- list()
  
  for (iso in EXTRA_COUNTRIES) {
    if (!iso %in% unique(fao_sub$Country_ISO)) next
    if (is.null(extra_climate_by_crop[[crop_name]][[iso]])) next
    
