                        ifelse(length(break_flag) > 0, paste(crop_labels[break_flag], collapse = ", "), "none")),
      caption  = "Chow-type interaction test | Statistical comparison only, no causal/adaptation claim",
      x = NULL, y = "TMX_c coefficient") +
