build_model_row <- function(crop_name, model_id) {
  sub <- key_coef %>% dplyr::filter(crop == crop_name, model == model_id)
  get_var <- function(varname) {
    r <- sub[sub$variable == varname, ]
    if (nrow(r) == 0) return(list(coef = NA_real_, se = NA_real_, sig = ""))
    list(coef = r$coef[1], se = r$se[1], sig = r$sig[1])
  }
  tmx <- get_var("TMX_c"); pre <- get_var("PRE_c"); irr <- get_var("IRR"); gdp <- get_var("ln_gdp")
  
  adj_row <- adjr2_wide[adjr2_wide$crop == crop_name, ]
  adjr2_col <- paste0("adjr2_", model_id)
  n_col     <- paste0("N_", model_id)
  adjr2_val <- if (nrow(adj_row) > 0 && adjr2_col %in% names(adj_row)) adj_row[[adjr2_col]][1] else NA_real_
  n_val     <- if (nrow(adj_row) > 0 && n_col %in% names(adj_row)) adj_row[[n_col]][1] else NA_integer_
  
  data.frame(
    crop = crop_name, model = model_id,
    TMX_coef = tmx$coef, TMX_se = tmx$se, TMX_sig = tmx$sig,
    PRE_coef = pre$coef, PRE_se = pre$se, PRE_sig = pre$sig,
    IRR_coef = irr$coef, IRR_se = irr$se, IRR_sig = irr$sig,
    GDP_coef = gdp$coef, GDP_se = gdp$se, GDP_sig = gdp$sig,
    AdjR2 = adjr2_val, N = n_val, stringsAsFactors = FALSE)
}

