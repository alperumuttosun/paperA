  ifelse(is.na(p), "", ifelse(p < 0.01, "***", ifelse(p < 0.05, "**", ifelse(p < 0.10, "*", ""))))

dk_list <- list()

for (crop_name in crop_list) {
  
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  cat("\n", strrep("=", 60), "\n", toupper(crop_name), "\n", strrep("=", 60), "\n")
  
  df_raw <- as.data.frame(readxl::read_excel(f))
  df_raw$Yil <- as.integer(as.character(df_raw$Yil))
  df_raw$ln_yield <- suppressWarnings(log(df_raw$yield_hg_per_ha))
  df_raw$ln_yield[!is.finite(df_raw$ln_yield)] <- NA
  df_raw$ln_gdp <- suppressWarnings(log(df_raw$GDP_per_Capita))
  df_raw$ln_gdp[!is.finite(df_raw$ln_gdp)] <- NA
  df_raw$IRR <- pmin(pmax(df_raw$irr_ratio, 0), 1)
  df_raw$Country_ISO <- as.character(df_raw$Country_ISO)
  
  # SAME filter as Step03's GDP subsample (M3/M4/M7/M8/...)
  df_gdp <- df_raw %>%
    dplyr::filter(!is.na(ln_yield), is.finite(ln_yield),
                  !is.na(TMX_ann), is.finite(TMX_ann),
                  !is.na(PRE_ann), is.finite(PRE_ann),
                  !is.na(IRR),
                  !is.na(ln_gdp), is.finite(ln_gdp),
                  !is.na(area_harvested_ha), area_harvested_ha > 0,
                  !is.na(production_tonnes), production_tonnes > 0)
  
  TMX_mean <- mean(df_gdp$TMX_ann, na.rm = TRUE)
  PRE_mean <- mean(df_gdp$PRE_ann, na.rm = TRUE)
  df_gdp$TMX_c <- df_gdp$TMX_ann - TMX_mean
  df_gdp$PRE_c <- df_gdp$PRE_ann - PRE_mean
  
  # SAME M4 model as Step03: production-weighted fixest::feols
  w <- df_gdp$production_tonnes
  m4 <- tryCatch(
    fixest::feols(ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp | Country_ISO + Yil,
                  data = df_gdp, weights = w, cluster = ~Country_ISO),
    error = function(e) { cat("  [ERROR feols]:", e$message, "\n"); NULL })
  if (is.null(m4)) next
  
  cf <- coef(m4)
  
  # Country-clustered SE (already computed by feols above)
  se_cluster <- se(m4)
  p_cluster  <- pvalue(m4)
  
  # Driscoll-Kraay SE on the SAME fitted (weighted) model.
  # FIX: explicit time variable via the DK ~ Yil formula syntax.
  m4_dk <- tryCatch(
    summary(m4, vcov = DK ~ Yil),
    error = function(e) { cat("  [ERROR DK vcov]:", e$message, "\n"); NULL })
  if (is.null(m4_dk)) next
  se_dk <- se(m4_dk)
  p_dk  <- pvalue(m4_dk)
  
  row <- data.frame(
    crop = crop_name, variable = names(cf), coef = as.numeric(cf),
    se_cluster = se_cluster, p_cluster = p_cluster, sig_cluster = sig_s(p_cluster),
    se_dk = se_dk, p_dk = p_dk, sig_dk = sig_s(p_dk),
    cd_flagged = crop_name %in% CD_FLAGGED,
    significance_changed = sig_s(p_cluster) != sig_s(p_dk),
    stringsAsFactors = FALSE)
  dk_list[[crop_name]] <- row
  
  tmx_row <- row[row$variable == "TMX_c", ]
  cat(sprintf("TMX_c = %+.4f | Clustered SE = %.4f (p=%.4f%s) | DK SE = %.4f (p=%.4f%s)\n",
              tmx_row$coef, tmx_row$se_cluster, tmx_row$p_cluster, tmx_row$sig_cluster,
              tmx_row$se_dk, tmx_row$p_dk, tmx_row$sig_dk))
  
  rm(df_gdp, df_raw, m4); gc()
}

