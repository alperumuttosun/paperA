# ==============================================================================
# STEP 11b -- BOOTSTRAP-CORRECTED BREAKPOINT SIGNIFICANCE
# Corrects tau*'s raw p-value for the multiple-testing/pretesting problem
# flagged in Step11: since ~40+ candidate years were searched and the
# strongest one selected, the raw p-value at tau* is NOT a valid test.
# This step computes a bootstrap-corrected p-value for the max-Wald
# statistic at each crop's tau*, following the sup-Wald bootstrap logic
# standard for Andrews (1993)-style unknown-breakpoint tests.
# ==============================================================================

library(dplyr)
library(readxl)
library(writexl)
library(fixest)

base_dir  <- "C:/Users/Alper.Tosun/Desktop/cru130"
crop_list <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

N_BOOT <- 1000          # number of bootstrap replications per crop
TRIM   <- 0.15          # same 15% trimming as Step11
set.seed(20260804)      # reproducibility

bootstrap_max_wald <- function(df, candidate_years, B = N_BOOT) {
  # For each bootstrap replication: resample countries WITH replacement
  # (block bootstrap over the cross-sectional unit, standard for panel
  # breakpoint tests), re-run the full tau search, and record the max
  # Wald statistic achieved. This builds the null distribution of the
  # "best of ~40+ tries" statistic under resampling.
  countries <- unique(df$Country_ISO)
  boot_max  <- numeric(B)
  
  for (b in seq_len(B)) {
    boot_countries <- sample(countries, length(countries), replace = TRUE)
    # rebuild a resampled panel by stacking the chosen countries
    boot_df <- dplyr::bind_rows(lapply(seq_along(boot_countries), function(i) {
      d <- df[df$Country_ISO == boot_countries[i], ]
      d$Country_ISO <- paste0(d$Country_ISO, "_boot", i)  # avoid FE collision
      d
    }))
    
    best_wald_b <- 0
    for (tau in candidate_years) {
      boot_df$post_break <- as.integer(boot_df$Yil >= tau)
      m_b <- tryCatch(
        fixest::feols(ln_yield ~ TMX_c + PRE_c + TMX_c:post_break + PRE_c:post_break
                      | Country_ISO + Yil,
                      data = boot_df, cluster = ~Country_ISO),
        error = function(e) NULL)
      if (is.null(m_b)) next
      w_b <- tryCatch(fixest::wald(m_b, keep = "post_break"), error = function(e) NULL)
      if (is.null(w_b)) next
      if (!is.na(w_b$stat) && w_b$stat > best_wald_b) best_wald_b <- w_b$stat
    }
    boot_max[b] <- best_wald_b
    if (b %% 100 == 0) cat(sprintf("  ...bootstrap %d / %d\n", b, B))
  }
  boot_max
}

results <- list()

for (crop_name in crop_list) {
  
  cat("\n", strrep("=", 60), "\n", toupper(crop_name), "\n", strrep("=", 60), "\n")
  
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  df_raw <- as.data.frame(readxl::read_excel(f))
  df_raw$Yil <- as.integer(as.character(df_raw$Yil))
  df_raw$ln_yield <- suppressWarnings(log(df_raw$yield_hg_per_ha))
  df_raw$ln_yield[!is.finite(df_raw$ln_yield)] <- NA
  df_raw$Country_ISO <- as.character(df_raw$Country_ISO)
  
  df <- df_raw %>%
    dplyr::filter(!is.na(ln_yield), is.finite(ln_yield),
                  !is.na(TMX_ann), is.finite(TMX_ann),
                  !is.na(PRE_ann), is.finite(PRE_ann),
                  !is.na(area_harvested_ha), area_harvested_ha > 0)
  
  TMX_mean <- mean(df$TMX_ann, na.rm = TRUE)
  PRE_mean <- mean(df$PRE_ann, na.rm = TRUE)
  df$TMX_c <- df$TMX_ann - TMX_mean
  df$PRE_c <- df$PRE_ann - PRE_mean
  
  years <- sort(unique(df$Yil))
  n_trim <- floor(TRIM * length(years))
  candidate_years <- years[(n_trim + 1):(length(years) - n_trim)]
  
  # -- Step 1: recover the ORIGINAL max Wald statistic (should match Step11's tau*)
  best_wald_orig <- 0
  best_tau_orig  <- NA
  for (tau in candidate_years) {
    df$post_break <- as.integer(df$Yil >= tau)
    m_tau <- tryCatch(
      fixest::feols(ln_yield ~ TMX_c + PRE_c + TMX_c:post_break + PRE_c:post_break
                    | Country_ISO + Yil,
                    data = df, cluster = ~Country_ISO),
      error = function(e) NULL)
    if (is.null(m_tau)) next
    w <- tryCatch(fixest::wald(m_tau, keep = "post_break"), error = function(e) NULL)
    if (is.null(w)) next
    if (!is.na(w$stat) && w$stat > best_wald_orig) {
      best_wald_orig <- w$stat
      best_tau_orig  <- tau
    }
  }
  
  cat(sprintf("Original tau* = %d | max Wald = %.3f\n", best_tau_orig, best_wald_orig))
  cat(sprintf("Running %d bootstrap replications...\n", N_BOOT))
  
  boot_max <- bootstrap_max_wald(df, candidate_years, B = N_BOOT)
  
  # Bootstrap-corrected p-value: share of bootstrap max-Wald stats
  # that meet or exceed the ORIGINAL max-Wald statistic
  corrected_p <- mean(boot_max >= best_wald_orig, na.rm = TRUE)
  
  cat(sprintf("[RESULT] %s: tau*=%d, max_Wald=%.3f, corrected_p=%.4f %s\n",
              crop_name, best_tau_orig, best_wald_orig, corrected_p,
              ifelse(corrected_p < 0.05, "[SIGNIFICANT after correction]",
                     "[NOT significant after correction]")))
  
  results[[crop_name]] <- data.frame(
    crop = crop_name, tau_star = best_tau_orig, max_wald = best_wald_orig,
    corrected_p = corrected_p, n_boot = N_BOOT,
    significant_corrected = corrected_p < 0.05,
    stringsAsFactors = FALSE)
  
  rm(df, df_raw, boot_max); gc()
}

results_df <- dplyr::bind_rows(results)

