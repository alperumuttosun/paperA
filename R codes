# ==============================================================================
# HELPER FUNCTIONS
# ==============================================================================

sig_s <- function(p)
  ifelse(is.na(p), "", ifelse(p < 0.01, "***", ifelse(p < 0.05, "**", ifelse(p < 0.10, "*", ""))))

# Fit a model with production (or specified) weights and country-clustered SE
fit_model <- function(formula, data, wt_var, lbl) {
  w <- data[[wt_var]]
  w[is.na(w) | w <= 0] <- NA
  m <- tryCatch(
    fixest::feols(formula, data = data, weights = w, cluster = ~Country_ISO),
    error = function(e) { cat(sprintf("  [ERROR %-6s]: %s\n", lbl, e$message)); NULL })
  if (!is.null(m)) {
    ar2 <- tryCatch(as.numeric(fixest::r2(m, "ar2")), error = function(e) NA_real_)
    n   <- tryCatch(stats::nobs(m), error = function(e) NA_integer_)
    cat(sprintf("  [%-6s]  AdjR2 = %+.4f  N = %d\n", lbl, ifelse(is.na(ar2), -99, ar2),
                ifelse(is.na(n), 0L, n)))
  }
  m
}

# Extract full coefficient table from a fitted model
coef_rows <- function(m, model_id, crop_name) {
  if (is.null(m)) return(NULL)
  cf <- tryCatch(coef(m), error = function(e) NULL)
  vc <- tryCatch(vcov(m), error = function(e) NULL)
  if (is.null(cf) || is.null(vc)) return(NULL)
  se <- sqrt(diag(vc))
  pv <- 2 * pnorm(-abs(cf / se))
  data.frame(
    crop = crop_name, model = model_id, variable = names(cf),
    coef = as.numeric(cf), se = as.numeric(se), pval = as.numeric(pv),
    sig  = sig_s(pv), lo95 = as.numeric(cf - 1.96 * se), hi95 = as.numeric(cf + 1.96 * se),
    row.names = NULL, stringsAsFactors = FALSE)
}


# ==============================================================================
# OUTPUT CONTAINERS
# ==============================================================================

all_coef_list <- list()
all_adjr2_list <- list()


# ==============================================================================
# MAIN LOOP -- estimate M1-M23 for all crops
# ==============================================================================

for (crop_name in crop_list) {
  
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  cat("\n", strrep("=", 65), "\n")
  cat(toupper(crop_name), "\n")
  cat(strrep("=", 65), "\n")
  
  df_raw <- as.data.frame(readxl::read_excel(f))
  df_raw$Yil <- as.integer(as.character(df_raw$Yil))
  
  # -- Derived variables ---------------------------------------------------------
  df_raw$ln_yield <- suppressWarnings(log(df_raw$yield_hg_per_ha))
  df_raw$ln_yield[!is.finite(df_raw$ln_yield)] <- NA
  df_raw$ln_gdp <- suppressWarnings(log(df_raw$GDP_per_Capita))
  df_raw$ln_gdp[!is.finite(df_raw$ln_gdp)] <- NA
  df_raw$IRR <- pmin(pmax(df_raw$irr_ratio, 0), 1)
  df_raw$Country_ISO <- as.character(df_raw$Country_ISO)
  
  # -- Build the full estimation sample (no GDP requirement) ---------------------
  df <- df_raw %>%
    dplyr::filter(
      !is.na(ln_yield), is.finite(ln_yield),
      !is.na(TMX_ann),  is.finite(TMX_ann),
      !is.na(PRE_ann),  is.finite(PRE_ann),
      !is.na(IRR),
      !is.na(area_harvested_ha), area_harvested_ha > 0,
      !is.na(production_tonnes), production_tonnes > 0)
  
  # Mean-centering: uses this crop's own full-sample mean (Schlenker &
  # Roberts 2009 centering convention -- see header comment)
  TMX_mean <- mean(df$TMX_ann, na.rm = TRUE)
  PRE_mean <- mean(df$PRE_ann, na.rm = TRUE)
  df$TMX_c  <- df$TMX_ann - TMX_mean
  df$TMX_sq <- df$TMX_c^2
  df$PRE_c  <- df$PRE_ann - PRE_mean
  df$PRE_sq <- df$PRE_c^2
  
  # GDP subsample (needed for M3/M4/M7/M8/M11/M12/M15/M16/M17-M23)
  df_gdp <- df %>% dplyr::filter(!is.na(ln_gdp), is.finite(ln_gdp))
  
  cat(sprintf("Full sample N = %d | GDP subsample N = %d | Countries (full) = %d\n",
              nrow(df), nrow(df_gdp), dplyr::n_distinct(df$Country_ISO)))
  cat(sprintf("TMX centering mean = %.2f degC | PRE centering mean = %.1f mm\n",
              TMX_mean, PRE_mean))
  
  # -- Model formulas: Blocks A-D (M1-M16) ----------------------------------------
  fm <- list(
    M1  = ln_yield ~ TMX_c + PRE_c                                       | Country_ISO + Yil,
    M2  = ln_yield ~ TMX_c + PRE_c + IRR                                 | Country_ISO + Yil,
    M3  = ln_yield ~ TMX_c + PRE_c + ln_gdp                              | Country_ISO + Yil,
    M4  = ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp                        | Country_ISO + Yil,
    M5  = ln_yield ~ TMX_c + TMX_sq + PRE_c                              | Country_ISO + Yil,
    M6  = ln_yield ~ TMX_c + TMX_sq + PRE_c + IRR                        | Country_ISO + Yil,
    M7  = ln_yield ~ TMX_c + TMX_sq + PRE_c + ln_gdp                     | Country_ISO + Yil,
    M8  = ln_yield ~ TMX_c + TMX_sq + PRE_c + IRR + ln_gdp               | Country_ISO + Yil,
    M9  = ln_yield ~ TMX_c + PRE_c + PRE_sq                              | Country_ISO + Yil,
    M10 = ln_yield ~ TMX_c + PRE_c + PRE_sq + IRR                        | Country_ISO + Yil,
    M11 = ln_yield ~ TMX_c + PRE_c + PRE_sq + ln_gdp                     | Country_ISO + Yil,
    M12 = ln_yield ~ TMX_c + PRE_c + PRE_sq + IRR + ln_gdp               | Country_ISO + Yil,
    M13 = ln_yield ~ TMX_c + TMX_sq + PRE_c + PRE_sq                     | Country_ISO + Yil,
    M14 = ln_yield ~ TMX_c + TMX_sq + PRE_c + PRE_sq + IRR               | Country_ISO + Yil,
    M15 = ln_yield ~ TMX_c + TMX_sq + PRE_c + PRE_sq + ln_gdp            | Country_ISO + Yil,
    M16 = ln_yield ~ TMX_c + TMX_sq + PRE_c + PRE_sq + IRR + ln_gdp      | Country_ISO + Yil)
  
  full_sample_models  <- c("M1","M2","M5","M6","M9","M10","M13","M14")
  gdp_sample_models    <- c("M3","M4","M7","M8","M11","M12","M15","M16")
  
  mods <- list()
  cat("\n-- Blocks A-D (M1-M16) --\n")
  for (nm in full_sample_models) mods[[nm]] <- fit_model(fm[[nm]], df,     "production_tonnes", nm)
  for (nm in gdp_sample_models)  mods[[nm]] <- fit_model(fm[[nm]], df_gdp, "production_tonnes", nm)
  
  # -- Block E: M17-M23 (all built on M4, all use GDP subsample) -----------------
  cat("\n-- Block E (M17-M23, robustness) --\n")
  
  # M17: country-specific linear trend. fixest's Country_ISO[Yil] syntax,
  # placed in the fixed-effects part, gives BOTH the country fixed effect
  # AND a country-specific linear slope on Yil in one term; Yil is kept
  # separately for the common year effect.
  fm_m17 <- ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp | Country_ISO[Yil] + Yil
  mods[["M17"]] <- fit_model(fm_m17, df_gdp, "production_tonnes", "M17")
  
  # M18: detrended yield (two-stage). Stage 1: remove country FE + country-
  # specific linear year trend from ln_yield (no other covariates -- this
  # is purely a detrending step). Stage 2: run M4 on the residual.
  #
  # NOTE: fixest silently drops "singleton" observations (e.g. a country
  # left with only 1 row after fixed-effect + varying-slope structure) --
  # resid() then returns a vector SHORTER than df_gdp. fixest::obs()
  # returns which row indices were actually used, so residuals are mapped
  # back to exactly those rows; any dropped row is left as NA and is then
  # naturally excluded from stage 2 (consistent with the same singleton
  # already being dropped in every other GDP-sample model).
  stage1 <- tryCatch(
    fixest::feols(ln_yield ~ 1 | Country_ISO[Yil], data = df_gdp),
    error = function(e) NULL)
  if (!is.null(stage1)) {
    used_idx <- fixest::obs(stage1)
    df_gdp$ln_yield_detrended <- NA_real_
    df_gdp$ln_yield_detrended[used_idx] <- resid(stage1)
    fm_m18 <- ln_yield_detrended ~ TMX_c + PRE_c + IRR + ln_gdp | Country_ISO + Yil
    mods[["M18"]] <- fit_model(fm_m18, df_gdp, "production_tonnes", "M18")
  } else {
    cat("  [ERROR M18]: stage-1 detrending failed\n")
    mods[["M18"]] <- NULL
  }
  
  # M19: fixed baseline production weight (1990-2000-or-fallback, from Step00)
  fm_m4 <- ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp | Country_ISO + Yil
  if ("baseline_production_tonnes" %in% names(df_gdp)) {
    mods[["M19"]] <- fit_model(fm_m4, df_gdp, "baseline_production_tonnes", "M19")
  } else {
    cat("  [SKIP M19]: baseline_production_tonnes column not found\n")
  }
  
  # M20: fixed baseline area weight (same baseline window, area instead of production)
  if ("baseline_area_harvested_ha" %in% names(df_gdp)) {
    mods[["M20"]] <- fit_model(fm_m4, df_gdp, "baseline_area_harvested_ha", "M20")
  } else {
    cat("  [SKIP M20]: baseline_area_harvested_ha column not found\n")
  }
  
  # M21: IRR x TMX_c interaction (does irrigation buffer heat damage?)
  fm_m21 <- ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp + TMX_c:IRR | Country_ISO + Yil
  mods[["M21"]] <- fit_model(fm_m21, df_gdp, "production_tonnes", "M21")
  
  # M22: ln_gdp x TMX_c interaction (income-related adaptation signal -- suggestive only)
  fm_m22 <- ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp + TMX_c:ln_gdp | Country_ISO + Yil
  mods[["M22"]] <- fit_model(fm_m22, df_gdp, "production_tonnes", "M22")
  
  # M23: is_arid_fixed x TMX_c interaction (structural aridity x heat -- suggestive only)
  if ("is_arid_fixed" %in% names(df_gdp) && sum(!is.na(df_gdp$is_arid_fixed)) > 0) {
    fm_m23 <- ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp + TMX_c:is_arid_fixed | Country_ISO + Yil
    mods[["M23"]] <- fit_model(fm_m23, df_gdp, "production_tonnes", "M23")
  } else {
    cat("  [SKIP M23]: is_arid_fixed column not found\n")
  }
  
  n_ok <- sum(!sapply(mods, is.null))
  cat(sprintf("\nSuccessful models: %d / 23\n", n_ok))
  
  # -- Extract coefficients + AdjR2 -----------------------------------------------
  for (nm in names(mods)) {
    m <- mods[[nm]]
    if (is.null(m)) next
    all_coef_list[[paste0(crop_name, "_", nm)]] <- coef_rows(m, nm, crop_name)
    
    ar2 <- tryCatch(as.numeric(fixest::r2(m, "ar2")), error = function(e) NA_real_)
    n   <- tryCatch(as.integer(stats::nobs(m)), error = function(e) NA_integer_)
    all_adjr2_list[[paste0(crop_name, "_", nm)]] <- data.frame(
      crop = crop_name, model = nm, adjr2 = ar2, N = n, stringsAsFactors = FALSE)
  }
  
  # -- Console: TMX_c across M1-M4 --------------------------------------------------
