query_isimip_dataset <- function(gcm, scenario, variable = "tasmax") {
  gcm_lower <- tolower(gcm)
  query_url <- sprintf(
    "%s?climate_forcing=%s&climate_scenario=%s&climate_variable=%s&simulation_round=ISIMIP3b",
    ISIMIP_API_BASE, gcm_lower, scenario, variable)
  resp <- tryCatch(jsonlite::fromJSON(query_url, flatten = TRUE), error = function(e) {
    cat("  [API ERROR]:", e$message, "\n"); NULL
  })
  if (is.null(resp) || is.null(resp$count) || resp$count == 0) return(NULL)
  files_df <- resp$results$files[[1]]
  if (is.null(files_df) || nrow(files_df) == 0) return(NULL)
  files_df
}

extract_years_from_name <- function(filename) {
  m <- regmatches(filename, regexpr("[0-9]{4}_[0-9]{4}(?=\\.nc$)", filename, perl = TRUE))
  if (length(m) == 0 || nchar(m) == 0) return(NULL)
  as.integer(strsplit(m, "_")[[1]])
}

download_process_file <- function(file_url, filename, year_start, year_end) {
  local_path <- file.path(ISIMIP_DIR, filename)
  cat(sprintf("  Downloading (years %d-%d): %s\n", year_start, year_end, filename))
  ok <- tryCatch({
    download.file(file_url, local_path, mode = "wb", quiet = FALSE, method = "libcurl")
    TRUE
  }, error = function(e) { cat("  [DOWNLOAD ERROR]:", e$message, "\n"); FALSE })
  if (!ok || !file.exists(local_path)) return(NULL)
  
  annual_r <- tryCatch({
    r <- terra::rast(local_path)
    layer_dates <- terra::time(r)
    layer_years <- as.integer(format(layer_dates, "%Y"))
    keep <- layer_years >= year_start & layer_years <= year_end
    if (sum(keep) == 0) { unlink(local_path); return(NULL) }
    r_sub <- r[[keep]]
    sample_val <- terra::global(r_sub[[1]], "mean", na.rm = TRUE)[1, 1]
    if (!is.na(sample_val) && sample_val > 100) r_sub <- r_sub - 273.15  # Kelvin -> Celsius
    years_kept <- layer_years[keep]
    annual_means <- lapply(sort(unique(years_kept)), function(yr) {
      terra::mean(r_sub[[years_kept == yr]], na.rm = TRUE)
    })
    terra::mean(terra::rast(annual_means), na.rm = TRUE)
  }, error = function(e) { cat("  [PROCESS ERROR]:", e$message, "\n"); NULL })
  
  unlink(local_path)
  cat(sprintf("  Deleted (disk freed): %s\n", filename))
  annual_r
}

get_period_raster <- function(files_df, target_start, target_end) {
  chunk_rasters <- list()
  for (i in seq_len(nrow(files_df))) {
    fname <- files_df$name[i]
    yrs <- extract_years_from_name(fname)
    if (is.null(yrs)) next
    if (yrs[2] < target_start || yrs[1] > target_end) next
    overlap_start <- max(yrs[1], target_start)
    overlap_end   <- min(yrs[2], target_end)
    r <- download_process_file(files_df$file_url[i], fname, overlap_start, overlap_end)
    if (!is.null(r)) chunk_rasters[[fname]] <- r
  }
  if (length(chunk_rasters) == 0) return(NULL)
  terra::mean(terra::rast(chunk_rasters), na.rm = TRUE)
}

# Crop-specific country filtering built in directly (valid_countries +
# UNSTABLE_PAIRS exclusion), so a separate cleanup pass is no longer needed.
aggregate_to_country <- function(tmx_raster, crop_name, country_boundaries, valid_countries) {
  cropgrid_path <- file.path(cropgrids_dir, sprintf("CROPGRIDSv1.08_%s.nc", crop_name))
  if (!file.exists(cropgrid_path)) return(NULL)
  weight_r <- tryCatch(terra::rast(cropgrid_path), error = function(e) NULL)
  if (is.null(weight_r)) return(NULL)
  if (!terra::compareGeom(tmx_raster, weight_r, stopOnError = FALSE)) {
    weight_r <- terra::resample(weight_r, tmx_raster, method = "bilinear")
  }
  weighted_tmx <- tmx_raster * weight_r
  country_weighted_sum <- terra::extract(weighted_tmx, country_boundaries, fun = sum, na.rm = TRUE)
  country_weight_sum   <- terra::extract(weight_r, country_boundaries, fun = sum, na.rm = TRUE)
  result <- data.frame(Country_ISO = country_boundaries$GID_0,
                       TMX_weighted = country_weighted_sum[, 2] / country_weight_sum[, 2],
                       stringsAsFactors = FALSE)
  result <- result[result$Country_ISO %in% valid_countries, ]
  for (pair in UNSTABLE_PAIRS) {
    if (crop_name == pair["crop"]) result <- result[result$Country_ISO != pair["iso"], ]
  }
  result
}


