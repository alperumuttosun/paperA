cat("\n\n", strrep("=", 90), "\n")
cat("DIAGNOSTIC SUMMARY -- ALL CROPS\n")
cat(strrep("=", 90), "\n\n")

diag_summary <- break_df %>%
  dplyr::select(crop, TMX_pre1990, TMX_post1990, joint_wald_p, break_detected) %>%
