deltas_df <- as.data.frame(readxl::read_excel(deltas_path, sheet = "Country_GCM_Deltas"))
cat(sprintf("Loaded %d climate delta rows.\n", nrow(deltas_df)))

step03_path <- file.path(base_dir, "step03_analysis3_models.xlsx")
if (!file.exists(step03_path)) stop("[HALT] step03_analysis3_models.xlsx not found -- run Step03 first.")
m4_coefs <- as.data.frame(readxl::read_excel(step03_path, sheet = "KeyCoefficients")) %>%
  dplyr::filter(model == "M4", variable == "TMX_c") %>%
  dplyr::select(crop, coef, se)
cat(sprintf("Loaded M4 TMX coefficients for %d crops.\n\n", nrow(m4_coefs)))


# ==============================================================================
# STEP 2 -- AGGREGATE COUNTRY DELTAS TO CROP-LEVEL, PER GCM/SCENARIO/PERIOD
# (production-weighted, using each crop's fixed 1990-2000 baseline weight)
# ==============================================================================

cat(strrep("=", 65), "\n"); cat("STEP 2 -- Production-weighted aggregation to crop level\n"); cat(strrep("=", 65), "\n\n")

crop_level_deltas <- list()

for (crop_name in crop_list) {
  panel_path <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(panel_path)) { cat(sprintf("[SKIP] panelv7_%s.xlsx not found\n", crop_name)); next }
  panel_df <- as.data.frame(readxl::read_excel(panel_path))
  if (!"baseline_production_tonnes" %in% names(panel_df)) {
    cat(sprintf("[SKIP] %s: baseline_production_tonnes column not found\n", crop_name)); next
  }
  weights_df <- panel_df %>%
    dplyr::filter(!is.na(baseline_production_tonnes), baseline_production_tonnes > 0) %>%
    dplyr::distinct(Country_ISO, .keep_all = TRUE) %>%
    dplyr::select(Country_ISO, baseline_production_tonnes)
  
  crop_deltas <- deltas_df %>% dplyr::filter(crop == crop_name)
  merged <- crop_deltas %>% dplyr::inner_join(weights_df, by = "Country_ISO")
  
  crop_summary <- merged %>%
    dplyr::group_by(gcm, scenario, period) %>%
    dplyr::summarise(
      weighted_delta = sum(delta_TMX * baseline_production_tonnes) / sum(baseline_production_tonnes),
      n_countries = dplyr::n(),
      .groups = "drop") %>%
    dplyr::mutate(crop = crop_name)
  
  crop_level_deltas[[crop_name]] <- crop_summary
  cat(sprintf("[%-8s] aggregated across %d GCM x scenario x period combinations\n",
              crop_name, nrow(crop_summary)))
}

crop_level_df <- dplyr::bind_rows(crop_level_deltas)


# ==============================================================================
# STEP 3 -- ENSEMBLE MEAN + MODEL RANGE (across the 5 GCMs), PER CROP/SCENARIO/PERIOD
# ==============================================================================

cat("\n", strrep("=", 65), "\n"); cat("STEP 3 -- Ensemble mean and model range across 5 GCMs\n"); cat(strrep("=", 65), "\n\n")

ensemble_df <- crop_level_df %>%
  dplyr::group_by(crop, scenario, period) %>%
  dplyr::summarise(
    ensemble_mean_delta = mean(weighted_delta, na.rm = TRUE),
    model_range_min = min(weighted_delta, na.rm = TRUE),
    model_range_max = max(weighted_delta, na.rm = TRUE),
    n_gcms = dplyr::n(),
    .groups = "drop")

cat(sprintf("Built ensemble summary for %d crop x scenario x period combinations (expect up to %d = 8 x 2 x 2).\n",
            nrow(ensemble_df), 8 * 2 * 2))
print(as.data.frame(ensemble_df))


# ==============================================================================
# STEP 4 -- APPLY M4 COEFFICIENT (regression 95% CI via delta method,
#           kept strictly separate from the model range above)
# ==============================================================================

cat("\n", strrep("=", 65), "\n"); cat("STEP 4 -- Applying M4 coefficient (regression CI, separate from model range)\n"); cat(strrep("=", 65), "\n\n")

results_df <- ensemble_df %>%
  dplyr::inner_join(m4_coefs, by = "crop") %>%
  dplyr::mutate(
    pct_change = (exp(coef * ensemble_mean_delta) - 1) * 100,
    pct_se     = exp(coef * ensemble_mean_delta) * se * ensemble_mean_delta,
    reg_lo95   = pct_change - 1.96 * pct_se,
    reg_hi95   = pct_change + 1.96 * pct_se,
    # Model range converted to the same %-change scale, for display only
    # (this is NOT a probabilistic interval -- see header note)
    model_range_pct_min = (exp(coef * model_range_min) - 1) * 100,
    model_range_pct_max = (exp(coef * model_range_max) - 1) * 100,
    is_secondary = period == "long_term")

# -- Sanity check: point estimate must fall within its own regression CI -------
sanity_fail <- results_df %>% dplyr::filter(pct_change < reg_lo95 | pct_change > reg_hi95)
if (nrow(sanity_fail) > 0) {
  cat(sprintf("[WARNING] %d rows fail the point-estimate-within-CI sanity check -- inspect before using:\n", nrow(sanity_fail)))
  print(sanity_fail)
} else {
  cat("[OK] Sanity check passed: point estimate falls within its regression CI for all rows.\n")
}

cat("\n--- Results table (PRIMARY = near_term; SECONDARY = long_term, heavily caveated) ---\n")
print_df <- results_df %>%
  dplyr::transmute(
    Crop = crop_labels[crop], Scenario = scenario,
    Period = ifelse(period == "near_term", "2041-2060 (PRIMARY)", "2081-2100 (SECONDARY)"),
    `% change` = round(pct_change, 2),
    `Regression 95% CI` = sprintf("[%.2f, %.2f]", reg_lo95, reg_hi95),
    `Model range (%)` = sprintf("[%.2f, %.2f]", model_range_pct_min, model_range_pct_max),
    `N GCMs` = n_gcms)
print(print_df, row.names = FALSE)


