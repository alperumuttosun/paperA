}


# ==============================================================================
# STEP 5 -- WITHIN-COUNTRY CORRELATION: TMX_ann vs ln_yield
# ==============================================================================

cat(strrep("=", 65), "\n")
cat("STEP 5 -- TMX_ann vs ln_yield WITHIN-COUNTRY CORRELATION\n")
cat("Ref: Lobell & Field (2007) -- within-country climate-yield signal\n")
cat(strrep("=", 65), "\n\n")

cor_list <- list()
for (crop_name in names(panel_list)) {
  df <- panel_list[[crop_name]]
  if (!all(c("TMX_ann","ln_yield","Country_ISO") %in% names(df))) next
  
  dm <- df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(
      tmx_dm = TMX_ann  - mean(TMX_ann,  na.rm = TRUE),
      lny_dm = ln_yield - mean(ln_yield, na.rm = TRUE)) %>%
    dplyr::ungroup() %>%
    dplyr::filter(!is.na(tmx_dm) & !is.na(lny_dm))
  
  if (nrow(dm) < 30) next
  r  <- cor(dm$tmx_dm, dm$lny_dm, use = "complete.obs")
  pv <- tryCatch(cor.test(dm$tmx_dm, dm$lny_dm)$p.value, error = function(e) NA_real_)
  
  cor_list[[crop_name]] <- data.frame(
    crop = crop_name, r_within = round(r, 4), pval = pv, n_obs = nrow(dm),
    stringsAsFactors = FALSE)
  
  sig <- if (!is.na(pv) && pv < 0.001) "***" else
    if (!is.na(pv) && pv < 0.01)  "**"  else
      if (!is.na(pv) && pv < 0.05)  "*"   else ""
  cat(sprintf("  [%-8s] r_within = %+.4f  p = %.4f %s  N = %d\n",
              crop_name, r, pv, sig, nrow(dm)))
}
cor_df <- dplyr::bind_rows(cor_list)
