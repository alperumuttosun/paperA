cat(sprintf("%-10s  %10s  %10s  %8s  %-6s  %8s  %8s  %-6s\n",
            "Crop", "TMXpre90", "TMXpost90", "BreakP", "Break?", "CD_p", "Haus_p", "FE_ok"))
cat(strrep("-", 80), "\n")
for (i in seq_len(nrow(diag_summary))) {
