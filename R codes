warn_df <- desc_df[!is.na(desc_df$Within_SD) & desc_df$Within_SD < 0.01, ]
if (nrow(warn_df) > 0) {
  cat("WARNING -- Low within-SD variables:\n")
  print(warn_df[, c("crop","variable","Within_SD","SD")], row.names = FALSE)
} else {
