for (crop_name in crop_list) {
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  cat(sprintf("\n%s\n%s\n%s\n", strrep("=", 60), toupper(crop_name), strrep("=", 60)))
  
  df <- as.data.frame(readxl::read_excel(f))
  df$Yil <- as.integer(as.character(df$Yil))
  
  # Derived variables (same construction as Step 01)
  df$ln_yield <- suppressWarnings(log(df$yield_hg_per_ha))
  df$ln_yield[!is.finite(df$ln_yield)] <- NA
  df$ln_gdp <- suppressWarnings(log(df$GDP_per_Capita))
  df$ln_gdp[!is.finite(df$ln_gdp)] <- NA
  if ("TMX_ann" %in% names(df)) df$TMX_sq <- df$TMX_ann^2
  if ("PRE_ann" %in% names(df)) df$PRE_sq <- df$PRE_ann^2
  
  mev      <- intersect(MODEL_VARS, names(df))
  df_model <- df[, c("Country_ISO", "Yil", mev), drop = FALSE]
  df_model <- df_model[!duplicated(df_model[, c("Country_ISO", "Yil")]), ]
  df_model <- df_model[complete.cases(df_model[, mev]), ]
  
  cat(sprintf("Complete observations: %d | Countries: %d | Years: %d-%d\n",
              nrow(df_model), length(unique(df_model$Country_ISO)),
              min(df_model$Yil, na.rm = TRUE), max(df_model$Yil, na.rm = TRUE)))
  
  if (nrow(df_model) < 30) { cat("  [SKIP] Too few complete observations\n"); next }
  
  # -- A) RAW CORRELATION -------------------------------------------------------
  cor_raw <- cor(df_model[, mev], use = "complete.obs")
  rownames(cor_raw) <- short_name[rownames(cor_raw)]
  colnames(cor_raw) <- short_name[colnames(cor_raw)]
  
  cat("\n[Raw correlation -- |r| > 0.4]\n")
  for (i in seq_len(nrow(cor_raw) - 1)) {
    for (j in (i + 1):ncol(cor_raw)) {
      r <- cor_raw[i, j]
      if (abs(r) >= 0.40) {
        flag <- ifelse(abs(r) >= 0.70, "*** HIGH", ifelse(abs(r) >= 0.50, "**  MEDIUM", "*   NOTE"))
        cat(sprintf("  %-9s -- %-9s : %+.3f  %s\n",
                    rownames(cor_raw)[i], colnames(cor_raw)[j], r, flag))
      }
    }
  }
  
  # -- B) WITHIN-COUNTRY CORRELATION --------------------------------------------
  # Note: is_arid_fixed is time-invariant by construction, so its within-
  # country demeaned value is always 0 -- excluded here to avoid a
  # degenerate (zero-variance) column, not because of a data problem.
  within_vars <- setdiff(mev, "is_arid_fixed")
  df_within <- df_model %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(dplyr::across(dplyr::all_of(within_vars), ~ . - mean(., na.rm = TRUE))) %>%
    dplyr::ungroup()
  
  cor_within <- cor(df_within[, within_vars], use = "complete.obs")
  rownames(cor_within) <- short_name[rownames(cor_within)]
  colnames(cor_within) <- short_name[colnames(cor_within)]
  
  cat("\n[Within-country correlation -- |r| > 0.4]\n")
  for (i in seq_len(nrow(cor_within) - 1)) {
    for (j in (i + 1):ncol(cor_within)) {
      r <- cor_within[i, j]
      if (abs(r) >= 0.40) {
        flag <- ifelse(abs(r) >= 0.70, "*** HIGH", ifelse(abs(r) >= 0.50, "**  MEDIUM", "*   NOTE"))
        cat(sprintf("  %-9s -- %-9s : %+.3f  %s\n",
                    rownames(cor_within)[i], colnames(cor_within)[j], r, flag))
      }
    }
  }
  
  # -- C) YEAR-TREND CONFOUNDING CHECK ------------------------------------------
  cat("\n[Year-trend confounding check]\n")
  trend_vars <- intersect(c("CO2_ppm", "ln_gdp"), within_vars)
  for (tv in trend_vars) {
    tv_s  <- short_name[tv]
    r_tmx <- if (all(c(tv_s, "TMX") %in% rownames(cor_within))) cor_within[tv_s, "TMX"] else NA_real_
    r_lny <- if (all(c(tv_s, "ln(Yield)") %in% rownames(cor_within))) cor_within[tv_s, "ln(Yield)"] else NA_real_
    cat(sprintf("  %s -- TMX within r = %+.3f | %s -- ln(Yield) within r = %+.3f\n",
                tv_s, r_tmx, tv_s, r_lny))
  }
  cat("  NOTE: High CO2-TMX within-r -> CO2 may confound TMX coefficient\n")
  cat("        Year FE absorbs common time trend\n")
  
  # -- D) VIF --------------------------------------------------------------------
  cat("\n[VIF -- full variable set, including TMX+TMX2 and PRE+PRE2]\n")
  vif_v <- compute_vif(df_model[, mev])
  if (!is.null(vif_v)) {
    print(vif_v)
    hi_vif <- vif_v[!is.na(vif_v) & vif_v > 10]
    if (length(hi_vif) > 0) {
      cat(sprintf("  [WARNING] VIF > 10: %s\n", paste(names(hi_vif), collapse = ", ")))
      cat("  -> Expected for TMX/TMX2 and PRE/PRE2 pairs (structural, not a bug):\n")
      cat("     M5-M16 models never enter TMX and TMX2 (or PRE and PRE2)\n")
      cat("     without their quadratic partner, so this collinearity is\n")
      cat("     inherent to the specification, not evidence of a data error.\n")
    } else {
      cat("  [OK] All VIF < 10\n")
    }
    vif_list[[crop_name]] <- data.frame(
      crop = crop_name, variable = names(vif_v), VIF = as.numeric(vif_v),
      hi_vif = as.numeric(vif_v) > 10, stringsAsFactors = FALSE)
  }
  
  # -- E) Store for summary and plots -------------------------------------------
  summary_list[[crop_name]] <- data.frame(
    crop            = crop_name,
    n_obs           = nrow(df_model),
    TMX_r_raw       = round(get_r(cor_raw,    "ln_yield", "TMX_ann"), 3),
    PRE_r_raw       = round(get_r(cor_raw,    "ln_yield", "PRE_ann"), 3),
    TMX_r_within    = round(get_r(cor_within, "ln_yield", "TMX_ann"), 3),
    PRE_r_within    = round(get_r(cor_within, "ln_yield", "PRE_ann"), 3),
    TMX_TMXsq_r_raw = round(get_r(cor_raw,    "TMX_ann", "TMX_sq"), 3),
    PRE_PREsq_r_raw = round(get_r(cor_raw,    "PRE_ann", "PRE_sq"), 3),
    CO2_TMX_within  = round(get_r(cor_within, "CO2_ppm", "TMX_ann"), 3),
    GDP_IRR_within  = round(get_r(cor_within, "ln_gdp",  "irr_ratio"), 3),
    stringsAsFactors = FALSE)
  
  raw_long_all[[crop_name]]    <- mat_to_long(cor_raw)    %>% dplyr::mutate(crop = crop_name, type = "raw")
  within_long_all[[crop_name]] <- mat_to_long(cor_within) %>% dplyr::mutate(crop = crop_name, type = "within")
  
  raw_wide_list[[crop_name]] <- as.data.frame(cor_raw) %>%
    dplyr::mutate(variable = rownames(cor_raw), crop = crop_name, type = "raw")
  within_wide_list[[crop_name]] <- as.data.frame(cor_within) %>%
    dplyr::mutate(variable = rownames(cor_within), crop = crop_name, type = "within")
}


