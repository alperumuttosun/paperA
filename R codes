  cat(sprintf("%-10s  %10.4f  %10.4f  %8.4f  %-6s  %8.4f  %8.4f  %-6s\n",
              r$crop, r$TMX_pre1990, r$TMX_post1990, r$joint_wald_p,
              ifelse(r$break_detected, "YES", "no"),
              r$cd_p, r$hausman_p, ifelse(r$fe_preferred, "FE", "RE ok")))
}

n_break <- sum(diag_summary$break_detected, na.rm = TRUE)
n_cd    <- sum(diag_summary$cd_p < 0.05, na.rm = TRUE)
n_fe    <- sum(diag_summary$fe_preferred, na.rm = TRUE)
cat(sprintf("\nStructural break detected in %d/%d crops\n", n_break, nrow(diag_summary)))
cat(sprintf("Cross-sectional dependence detected in %d/%d crops (Pesaran CD, p<0.05)\n",
