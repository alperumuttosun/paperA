save_plot <- function(g_labeled, plot_name, width = 10, height = 7) {
  g_unlabeled <- g_labeled +
    labs(title = NULL, subtitle = NULL, caption = NULL, x = NULL, y = NULL) +
    theme(legend.title = element_blank(), plot.margin = margin(4, 4, 4, 4))
  cat(sprintf("  [SCREEN] %s -- LABELED\n", plot_name)); print(g_labeled)
  cat(sprintf("  [SCREEN] %s -- UNLABELED\n", plot_name)); print(g_unlabeled)
  save_one <- function(g, dir_path) {
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, ".pdf")),
                    plot = g, width = width, height = height, device = "pdf")
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, "_1600dpi.png")),
                    plot = g, width = width, height = height, dpi = 1600, device = "png")
  }
  save_one(g_labeled, fig_labeled); save_one(g_unlabeled, fig_unlabeled)
  cat(sprintf("  [SAVED]  %s -> labeled/ + unlabeled/ (PDF + 1600dpi PNG)\n\n", plot_name))
  invisible(NULL)
}

fit_m4 <- function(data) tryCatch(
  fixest::feols(ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp | Country_ISO + Yil,
                data = data, weights = data$production_tonnes, cluster = ~Country_ISO),
  error = function(e) NULL)

fit_m13 <- function(data) tryCatch(
  fixest::feols(ln_yield ~ TMX_c + TMX_sq + PRE_c + PRE_sq | Country_ISO + Yil,
                data = data, weights = data$production_tonnes, cluster = ~Country_ISO),
  error = function(e) NULL)

loo_list        <- list()
block_list      <- list()
winsor_list     <- list()
loo_tmxsq_list  <- list()

for (crop_name in crop_list) {
  
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  cat("\n", strrep("=", 60), "\n", toupper(crop_name), "\n", strrep("=", 60), "\n")
  
  df_raw <- as.data.frame(readxl::read_excel(f))
  df_raw$Yil <- as.integer(as.character(df_raw$Yil))
  df_raw$ln_yield <- suppressWarnings(log(df_raw$yield_hg_per_ha))
  df_raw$ln_yield[!is.finite(df_raw$ln_yield)] <- NA
  df_raw$ln_gdp <- suppressWarnings(log(df_raw$GDP_per_Capita))
  df_raw$ln_gdp[!is.finite(df_raw$ln_gdp)] <- NA
  df_raw$IRR <- pmin(pmax(df_raw$irr_ratio, 0), 1)
  df_raw$Country_ISO <- as.character(df_raw$Country_ISO)
  
  # BUG FIX: added area_harvested_ha > 0 -- must match Step03's GDP-sample.
  df_gdp <- df_raw %>%
    dplyr::filter(!is.na(ln_yield), is.finite(ln_yield), !is.na(TMX_ann), !is.na(PRE_ann),
                  !is.na(IRR), !is.na(ln_gdp), is.finite(ln_gdp),
                  !is.na(area_harvested_ha), area_harvested_ha > 0,
                  !is.na(production_tonnes), production_tonnes > 0)
  TMX_mean_gdp <- mean(df_gdp$TMX_ann, na.rm = TRUE)
  PRE_mean_gdp <- mean(df_gdp$PRE_ann, na.rm = TRUE)
  df_gdp$TMX_c <- df_gdp$TMX_ann - TMX_mean_gdp
  df_gdp$PRE_c <- df_gdp$PRE_ann - PRE_mean_gdp
  
  # BUG FIX: added !is.na(IRR) and area_harvested_ha > 0.
  df_full <- df_raw %>%
    dplyr::filter(!is.na(ln_yield), is.finite(ln_yield), !is.na(TMX_ann), !is.na(PRE_ann),
                  !is.na(IRR),
                  !is.na(area_harvested_ha), area_harvested_ha > 0,
                  !is.na(production_tonnes), production_tonnes > 0)
  TMX_mean_full <- mean(df_full$TMX_ann, na.rm = TRUE)
  PRE_mean_full <- mean(df_full$PRE_ann, na.rm = TRUE)
  df_full$TMX_c  <- df_full$TMX_ann - TMX_mean_full
  df_full$TMX_sq <- df_full$TMX_c^2
  df_full$PRE_c  <- df_full$PRE_ann - PRE_mean_full
  df_full$PRE_sq <- df_full$PRE_c^2
  
  if (!is.null(step03_n_check)) {
    ref_row <- step03_n_check[step03_n_check$crop == crop_name, ]
    if (nrow(ref_row) > 0) {
      if (nrow(df_full) != ref_row$N_M1[1]) {
        cat(sprintf("  [WARNING] df_full N mismatch vs Step03! This script: %d | Step03 M1: %d\n",
                    nrow(df_full), ref_row$N_M1[1]))
      } else {
        cat(sprintf("  [OK] df_full N matches Step03's M1 sample exactly (%d).\n", nrow(df_full)))
      }
      if (nrow(df_gdp) != ref_row$N_M4[1]) {
        cat(sprintf("  [WARNING] df_gdp N mismatch vs Step03! This script: %d | Step03 M4: %d\n",
                    nrow(df_gdp), ref_row$N_M4[1]))
      } else {
        cat(sprintf("  [OK] df_gdp N matches Step03's M4 sample exactly (%d).\n", nrow(df_gdp)))
      }
    }
  }
  
  m4_full  <- fit_m4(df_gdp)
  m13_full <- fit_m13(df_full)
  if (is.null(m4_full)) { cat("  [ERROR] M4 full-sample failed\n"); next }
  
  tmx_full <- coef(m4_full)["TMX_c"]
  cat(sprintf("Full-sample M4 TMX_c = %+.4f\n", tmx_full))
  
  top_countries <- df_gdp %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::summarise(total_prod = sum(production_tonnes, na.rm = TRUE), .groups = "drop") %>%
    dplyr::arrange(dplyr::desc(total_prod)) %>%
    dplyr::slice_head(n = TOP_N_LOO) %>%
    dplyr::pull(Country_ISO)
  
  cat(sprintf("Top %d producers: %s\n", length(top_countries), paste(top_countries, collapse = ", ")))
  
  loo_rows <- list()
  for (iso in top_countries) {
    df_loo <- df_gdp %>% dplyr::filter(Country_ISO != iso)
    m_loo  <- fit_m4(df_loo)
    if (is.null(m_loo)) next
    tmx_loo <- coef(m_loo)["TMX_c"]
    loo_rows[[iso]] <- data.frame(
      crop = crop_name, excluded_country = iso, TMX_full = tmx_full, TMX_loo = tmx_loo,
      shift_pct = 100 * (tmx_loo - tmx_full) / abs(tmx_full),
      sign_flip = sign(tmx_loo) != sign(tmx_full),
      stringsAsFactors = FALSE)
  }
  loo_df_crop <- dplyr::bind_rows(loo_rows)
  loo_list[[crop_name]] <- loo_df_crop
  
  if (nrow(loo_df_crop) > 0) {
    max_shift <- loo_df_crop[which.max(abs(loo_df_crop$shift_pct)), ]
    cat(sprintf("Most influential country: %s (shift = %+.1f%%, sign_flip = %s)\n",
                max_shift$excluded_country, max_shift$shift_pct, max_shift$sign_flip))
    n_flip <- sum(loo_df_crop$sign_flip)
    cat(sprintf("Sign flips among top %d LOO exclusions: %d\n", TOP_N_LOO, n_flip))
  }
  
  if (crop_name %in% c("rice", "maize")) {
    cat(sprintf("\n[TARGETED] %s TMX_sq LOO (Step04 implausible-sign follow-up)\n", crop_name))
    tmx_sq_full <- coef(m13_full)["TMX_sq"]
    cat(sprintf("Full-sample M13 TMX_sq = %+.6f\n", tmx_sq_full))
    
    top_countries_full <- df_full %>%
      dplyr::group_by(Country_ISO) %>%
      dplyr::summarise(total_prod = sum(production_tonnes, na.rm = TRUE), .groups = "drop") %>%
      dplyr::arrange(dplyr::desc(total_prod)) %>%
      dplyr::slice_head(n = TOP_N_LOO) %>%
      dplyr::pull(Country_ISO)
    
    tmxsq_rows <- list()
    for (iso in top_countries_full) {
      df_loo2 <- df_full %>% dplyr::filter(Country_ISO != iso)
      m_loo2  <- fit_m13(df_loo2)
      if (is.null(m_loo2)) next
      tmxsq_loo <- coef(m_loo2)["TMX_sq"]
      tmxsq_rows[[iso]] <- data.frame(
        crop = crop_name, excluded_country = iso,
        TMX_sq_full = tmx_sq_full, TMX_sq_loo = tmxsq_loo,
        sign_flip_to_negative = tmxsq_loo < 0,
        stringsAsFactors = FALSE)
    }
    tmxsq_df <- dplyr::bind_rows(tmxsq_rows)
    loo_tmxsq_list[[crop_name]] <- tmxsq_df
    
    n_flip_neg <- sum(tmxsq_df$sign_flip_to_negative)
    cat(sprintf("Countries whose exclusion flips TMX_sq negative (correct sign): %d / %d\n",
                n_flip_neg, nrow(tmxsq_df)))
    if (n_flip_neg > 0) {
      cat("  ->", paste(tmxsq_df$excluded_country[tmxsq_df$sign_flip_to_negative], collapse = ", "), "\n")
    }
  }
  
  top3 <- top_countries[1:min(3, length(top_countries))]
  top5 <- top_countries[1:min(5, length(top_countries))]
  
  m4_top3 <- fit_m4(df_gdp %>% dplyr::filter(!Country_ISO %in% top3))
  m4_top5 <- fit_m4(df_gdp %>% dplyr::filter(!Country_ISO %in% top5))
  
  block_list[[crop_name]] <- data.frame(
    crop = crop_name,
    TMX_full = tmx_full,
    TMX_excl_top3 = if (!is.null(m4_top3)) coef(m4_top3)["TMX_c"] else NA_real_,
    TMX_excl_top5 = if (!is.null(m4_top5)) coef(m4_top5)["TMX_c"] else NA_real_,
    top3_countries = paste(top3, collapse = ","),
    top5_countries = paste(top5, collapse = ","),
    stringsAsFactors = FALSE)
  
  cat(sprintf("Excl. top 3 (%s): TMX_c = %+.4f | Excl. top 5: TMX_c = %+.4f\n",
              paste(top3, collapse = ","),
              ifelse(is.null(m4_top3), NA, coef(m4_top3)["TMX_c"]),
              ifelse(is.null(m4_top5), NA, coef(m4_top5)["TMX_c"])))
  
  p01 <- quantile(df_gdp$ln_yield, 0.01, na.rm = TRUE)
  p99 <- quantile(df_gdp$ln_yield, 0.99, na.rm = TRUE)
  df_wins <- df_gdp %>%
    dplyr::mutate(ln_yield = pmin(pmax(ln_yield, p01), p99))
  m4_wins <- fit_m4(df_wins)
  
  winsor_list[[crop_name]] <- data.frame(
    crop = crop_name, TMX_full = tmx_full,
    TMX_winsorized = if (!is.null(m4_wins)) coef(m4_wins)["TMX_c"] else NA_real_,
    stringsAsFactors = FALSE)
  
  cat(sprintf("Winsorized (1%%/99%%) TMX_c = %+.4f\n",
              ifelse(is.null(m4_wins), NA, coef(m4_wins)["TMX_c"])))
  
  rm(df_gdp, df_full, df_raw, m4_full, m13_full); gc()
}

