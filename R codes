save_plot <- function(g_labeled, plot_name, width = 10, height = 7) {
  g_unlabeled <- g_labeled +
    labs(title = NULL, subtitle = NULL, caption = NULL, x = NULL, y = NULL) +
    theme(legend.title = element_blank(), plot.margin = margin(4, 4, 4, 4))
  
  cat(sprintf("  [SCREEN] %s -- LABELED\n", plot_name)); print(g_labeled)
  cat(sprintf("  [SCREEN] %s -- UNLABELED\n", plot_name)); print(g_unlabeled)
  
  save_one <- function(g, dir_path) {
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, ".pdf")),
                    plot = g, width = width, height = height, device = "pdf")
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, "_1600dpi.png")),
                    plot = g, width = width, height = height, dpi = 1600, device = "png")
  }
  save_one(g_labeled, fig_labeled); save_one(g_unlabeled, fig_unlabeled)
  cat(sprintf("  [SAVED]  %s -> labeled/ + unlabeled/ (PDF + 1600dpi PNG)\n\n", plot_name))
  invisible(NULL)
}


# ==============================================================================
# HELPER: build a response curve (effect + delta-method CI) for one variable
# ==============================================================================

build_curve <- function(x_seq, b1, b2, var1, var2, cov12) {
  effect <- b1 * x_seq + b2 * x_seq^2
  var_e  <- (x_seq^2) * var1 + (x_seq^4) * var2 + 2 * (x_seq^3) * cov12
  var_e[var_e < 0] <- NA
  se <- sqrt(var_e)
  data.frame(x = x_seq, effect = effect, se = se,
             lo95 = effect - 1.96 * se, hi95 = effect + 1.96 * se)
}


# ==============================================================================
# MAIN LOOP
# ==============================================================================

tmx_curves_list <- list()
pre_curves_list <- list()
optimal_list    <- list()

for (crop_name in crop_list) {
  
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  cat("\n", strrep("=", 60), "\n", toupper(crop_name), "\n", strrep("=", 60), "\n")
  
  df_raw <- as.data.frame(readxl::read_excel(f))
  df_raw$Yil <- as.integer(as.character(df_raw$Yil))
  df_raw$ln_yield <- suppressWarnings(log(df_raw$yield_hg_per_ha))
  df_raw$ln_yield[!is.finite(df_raw$ln_yield)] <- NA
  df_raw$IRR <- pmin(pmax(df_raw$irr_ratio, 0), 1)
  df_raw$Country_ISO <- as.character(df_raw$Country_ISO)
  
  # BUG FIX (round 2): !is.na(IRR) was still missing after the first fix.
  # Step03 filters on IRR completeness even for models like M13 that don't
  # use IRR as a covariate, because it builds ONE shared full-sample `df`
  # for the entire M1/M2/M5/M6/M9/M10/M13/M14 block, keeping N constant
  # across that block for direct comparability. This script must match
  # that sample construction exactly, not just the variables M13 itself uses.
  df <- df_raw %>%
    dplyr::filter(
      !is.na(ln_yield), is.finite(ln_yield),
      !is.na(TMX_ann), is.finite(TMX_ann),
      !is.na(PRE_ann), is.finite(PRE_ann),
      !is.na(IRR),
      !is.na(area_harvested_ha), area_harvested_ha > 0,
      !is.na(production_tonnes), production_tonnes > 0)
  
  TMX_mean <- mean(df$TMX_ann, na.rm = TRUE)
  PRE_mean <- mean(df$PRE_ann, na.rm = TRUE)
  df$TMX_c  <- df$TMX_ann - TMX_mean
  df$TMX_sq <- df$TMX_c^2
  df$PRE_c  <- df$PRE_ann - PRE_mean
  df$PRE_sq <- df$PRE_c^2
  
  cat(sprintf("N = %d | TMX range = [%.1f, %.1f] (mean %.1f) | PRE range = [%.0f, %.0f] (mean %.0f)\n",
              nrow(df), min(df$TMX_ann), max(df$TMX_ann), TMX_mean,
              min(df$PRE_ann), max(df$PRE_ann), PRE_mean))
  
  w <- df$production_tonnes
  m13 <- tryCatch(
    fixest::feols(ln_yield ~ TMX_c + TMX_sq + PRE_c + PRE_sq | Country_ISO + Yil,
                  data = df, weights = w, cluster = ~Country_ISO),
    error = function(e) { cat("  [ERROR M13]:", e$message, "\n"); NULL })
  if (is.null(m13)) next
  
  cf <- coef(m13); vc <- vcov(m13)
  b_tmx  <- cf["TMX_c"];  b_tmx2 <- cf["TMX_sq"]
  b_pre  <- cf["PRE_c"];  b_pre2 <- cf["PRE_sq"]
  v_tmx  <- vc["TMX_c","TMX_c"];   v_tmx2 <- vc["TMX_sq","TMX_sq"];   cov_tmx  <- vc["TMX_c","TMX_sq"]
  v_pre  <- vc["PRE_c","PRE_c"];   v_pre2 <- vc["PRE_sq","PRE_sq"];   cov_pre  <- vc["PRE_c","PRE_sq"]
  p_tmx2 <- 2 * pnorm(-abs(b_tmx2 / sqrt(v_tmx2)))
  p_pre2 <- 2 * pnorm(-abs(b_pre2 / sqrt(v_pre2)))
  
  cat(sprintf("TMX_sq: coef=%.6f  p=%.4f %s | PRE_sq: coef=%.2e  p=%.4f %s\n",
              b_tmx2, p_tmx2, ifelse(p_tmx2 < 0.10, "(curvature detected)", "(NOT significant)"),
              b_pre2, p_pre2, ifelse(p_pre2 < 0.10, "(curvature detected)", "(NOT significant)")))
  
  # -- Cross-check against Step03's own M13 (bug-fix safeguard) ------------------
  if (!is.null(step03_m13_check)) {
    ref_row <- step03_m13_check[step03_m13_check$crop == crop_name, ]
    if (nrow(ref_row) > 0) {
      diff <- abs(b_tmx - ref_row$coef[1])
      if (diff > 1e-6) {
        cat(sprintf("  [WARNING] M13 TMX_c mismatch vs Step03! This script: %.6f | Step03: %.6f | diff = %.6f\n",
                    b_tmx, ref_row$coef[1], diff))
        cat("  [WARNING] Sample filter may have drifted out of sync with Step03 -- investigate before trusting this crop's curves.\n")
      } else {
        cat(sprintf("  [OK] M13 TMX_c matches Step03 exactly (%.6f).\n", b_tmx))
      }
    } else {
      cat(sprintf("  [NOTE] No Step03 M13 TMX_c reference found for %s -- cross-check skipped.\n", crop_name))
    }
  }
  
  # -- TMX response curve ----------------------------------------------------------
  tmx_seq <- seq(min(df$TMX_c), max(df$TMX_c), length.out = N_POINTS)
  tmx_curve <- build_curve(tmx_seq, b_tmx, b_tmx2, v_tmx, v_tmx2, cov_tmx)
  tmx_curve$TMX_actual <- tmx_curve$x + TMX_mean
  tmx_curve$crop <- crop_name
  tmx_curves_list[[crop_name]] <- tmx_curve
  
  # -- PRE response curve ----------------------------------------------------------
  pre_seq <- seq(min(df$PRE_c), max(df$PRE_c), length.out = N_POINTS)
  pre_curve <- build_curve(pre_seq, b_pre, b_pre2, v_pre, v_pre2, cov_pre)
  pre_curve$PRE_actual <- pre_curve$x + PRE_mean
  pre_curve$crop <- crop_name
  pre_curves_list[[crop_name]] <- pre_curve
  
  # -- Optimal point: x* = -b1 / (2*b2) --------------------------------------------
  classify_curvature <- function(pval, b2, in_range) {
    if (is.na(pval) || is.na(b2)) return("Not computed")
    if (pval >= 0.10) return("Not significant")
    if (b2 >= 0)       return("Implausible sign (U-shaped)")
    if (!in_range)     return("Out of range")
    "Reliable"
  }
  
  opt_tmx_c   <- if (abs(b_tmx2) > 1e-12) -b_tmx / (2 * b_tmx2) else NA_real_
  opt_tmx_val <- opt_tmx_c + TMX_mean
  opt_tmx_in_range <- !is.na(opt_tmx_val) &&
    opt_tmx_val >= min(df$TMX_ann) && opt_tmx_val <= max(df$TMX_ann)
  tmx_status       <- classify_curvature(p_tmx2, b_tmx2, opt_tmx_in_range)
  opt_tmx_reliable <- tmx_status == "Reliable"
  
  opt_pre_c   <- if (abs(b_pre2) > 1e-12) -b_pre / (2 * b_pre2) else NA_real_
  opt_pre_val <- opt_pre_c + PRE_mean
  opt_pre_in_range <- !is.na(opt_pre_val) &&
    opt_pre_val >= min(df$PRE_ann) && opt_pre_val <= max(df$PRE_ann)
  pre_status       <- classify_curvature(p_pre2, b_pre2, opt_pre_in_range)
  opt_pre_reliable <- pre_status == "Reliable"
  
  cat(sprintf("Optimal TMX = %.1f degC [%s] | Optimal PRE = %.0f mm [%s]\n",
              opt_tmx_val, tmx_status, opt_pre_val, pre_status))
  
  optimal_list[[crop_name]] <- data.frame(
    crop = crop_name, N = nrow(df),
    TMX_mean = round(TMX_mean, 2), PRE_mean = round(PRE_mean, 0),
    TMX_sq_coef = b_tmx2, TMX_sq_pval = p_tmx2,
    optimal_TMX = round(opt_tmx_val, 2), TMX_in_range = opt_tmx_in_range,
    TMX_reliable = opt_tmx_reliable, TMX_status = tmx_status,
    PRE_sq_coef = b_pre2, PRE_sq_pval = p_pre2,
    optimal_PRE = round(opt_pre_val, 0), PRE_in_range = opt_pre_in_range,
    PRE_reliable = opt_pre_reliable, PRE_status = pre_status,
    stringsAsFactors = FALSE)
  
  rm(df, df_raw, m13); gc()
