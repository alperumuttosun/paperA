                  !is.na(IRR), !is.na(ln_gdp), is.finite(ln_gdp),
                  !is.na(area_harvested_ha), area_harvested_ha > 0,
                  !is.na(production_tonnes), production_tonnes > 0)
  TMX_mean <- mean(df$TMX_ann, na.rm = TRUE)
  PRE_mean <- mean(df$PRE_ann, na.rm = TRUE)
  df$TMX_c <- df$TMX_ann - TMX_mean
  df$PRE_c <- df$PRE_ann - PRE_mean
  
  if (!is.null(step03_n_check)) {
    ref_row <- step03_n_check[step03_n_check$crop == crop_name, ]
    if (nrow(ref_row) > 0) {
      if (nrow(df) != ref_row$N_M4[1]) {
        cat(sprintf("  [WARNING] N mismatch vs Step03! This script: %d | Step03 M4: %d\n",
                    nrow(df), ref_row$N_M4[1]))
      } else {
        cat(sprintf("  [OK] N matches Step03's M4 sample exactly (%d).\n", nrow(df)))
      }
    }
  }
  
  year_min <- min(df$Yil); year_max <- max(df$Yil)
  span     <- year_max - year_min
  trim_n   <- round(TRIM_PCT * span)
  cand_lo  <- year_min + trim_n
  cand_hi  <- year_max - trim_n
  candidate_years <- cand_lo:cand_hi
  
  cat(sprintf("Sample range: %d-%d | Trimmed candidate range: %d-%d (%d years tested)\n",
              year_min, year_max, cand_lo, cand_hi, length(candidate_years)))
  
  crop_rows <- list()
  
  for (tau in candidate_years) {
    df$post_break <- as.integer(df$Yil >= tau)
    n_pre  <- sum(df$post_break == 0)
    n_post <- sum(df$post_break == 1)
    if (n_pre < MIN_OBS_PER_SIDE || n_post < MIN_OBS_PER_SIDE) next
    
    m_tau <- tryCatch(
      fixest::feols(ln_yield ~ TMX_c + PRE_c + IRR + ln_gdp + TMX_c:post_break + PRE_c:post_break
                    | Country_ISO + Yil,
                    data = df, weights = df$production_tonnes, cluster = ~Country_ISO),
      error = function(e) NULL)
    if (is.null(m_tau)) next
    
    wald_res <- tryCatch(fixest::wald(m_tau, keep = "post_break"), error = function(e) NULL)
    if (is.null(wald_res)) next
    
    crop_rows[[as.character(tau)]] <- data.frame(
      crop = crop_name, tau = tau,
      wald_stat = as.numeric(wald_res$stat), wald_p = wald_res$p,
      n_pre = n_pre, n_post = n_post, stringsAsFactors = FALSE)
  }
  
  crop_search <- dplyr::bind_rows(crop_rows)
  if (nrow(crop_search) == 0) { cat("  [ERROR] No candidate years produced a valid test\n"); next }
  
  search_list[[crop_name]] <- crop_search
  
  best <- crop_search[which.max(crop_search$wald_stat), ]
  argmax_list[[crop_name]] <- best
  
  cat(sprintf("tau* (argmax Wald) = %d | Wald stat = %.2f | raw p = %.4f [UNCORRECTED -- see caveat]\n",
              best$tau, best$wald_stat, best$wald_p))
  
  rm(df, df_raw); gc()
}

