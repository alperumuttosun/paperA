  cat(sprintf("  [SCREEN] %s -- UNLABELED\n", plot_name)); print(g_unlabeled)
  save_one <- function(g, dir_path) {
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, ".pdf")),
                    plot = g, width = width, height = height, device = "pdf")
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, "_1600dpi.png")),
                    plot = g, width = width, height = height, dpi = 1600, device = "png")
  }
  save_one(g_labeled, fig_labeled); save_one(g_unlabeled, fig_unlabeled)
  cat(sprintf("  [SAVED]  %s -> labeled/ + unlabeled/ (PDF + 1600dpi PNG)\n\n", plot_name))
