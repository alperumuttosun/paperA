# ==============================================================================
# STEP 06 -- ANALYSIS 6: DIAGNOSTIC TESTS
# Structural break, Pesaran CD (cross-sectional dependence), Hausman (FE vs RE)
# Annual multi-crop panel: TMX_ann, PRE_ann, no phenology, no VPD
#
# BUG FIX (this version): the sample filter was missing BOTH the
# `!is.na(IRR)` and `area_harvested_ha > 0` conditions that Step03 applies
# when building its full-sample df (used for M1/M2/M5/M6/M9/M10/M13/M14).
# This was the same class of error found and fixed in Step04/05 -- this
# script's sample was silently larger/different from Step03's, which could
# shift the diagnostic test statistics (though not the headline M1-M23
# estimates themselves, which only ever come from Step03). Filter now
# matches Step03's full-sample construction exactly. An N cross-check
# against Step03's saved full-sample N has been added at the start of each
# crop's loop iteration.
#
# Part A: Structural break around 1990 -- TMX_c/PRE_c interacted with a
#         post-1990 dummy (production-weighted, fixest, matching the
#         headline M1 specification), joint Wald test on the interaction
#         terms.
# Part B: Pesaran CD test -- tests whether residuals are correlated across
#         countries (cross-sectional dependence). Run on an UNWEIGHTED
#         two-way FE model fit via plm (weights are not part of the CD/
#         Hausman testing framework in this literature; these are model-
#         specification diagnostics, not the headline estimates).
# Part C: Hausman test -- FE vs RE for the country effect specifically.
#         Both FE and RE models include year fixed effects as explicit
#         dummies so the test isolates the country-effect comparison,
#         which is the valid, standard design for this test.
#
# All diagnostics are UNWEIGHTED by design (Parts B-C) or use only the
# main-model weighting (Part A) -- this does not replace or override the
# production-weighted M1-M23 results from Step03; it is a separate model-
# specification check layered on top of them.
#
# Plots: G_D1 (structural break, TMX coefficient pre/post-1990, all crops)
#   -- Saved: PDF + PNG 1600dpi x labeled + unlabeled, into the single
#      shared figures_paperv2/ folder used by every step
#
# References:
#   Pesaran (2004, 2015) -- CD test for cross-sectional dependence
#   Hausman (1978)       -- FE vs RE specification test
#   Chow (1960)          -- structural break testing logic
# ==============================================================================


# ==============================================================================
# 0. SETUP
# ==============================================================================

library(dplyr)
library(readxl)
library(writexl)
library(fixest)
library(plm)
library(ggplot2)

base_dir  <- "C:/Users/Alper.Tosun/Desktop/cru130"
crop_list <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")
BREAK_YEAR <- 1990

fig_labeled   <- file.path(base_dir, "figures_paperv2", "labeled")
fig_unlabeled <- file.path(base_dir, "figures_paperv2", "unlabeled")
dir.create(fig_labeled,   recursive = TRUE, showWarnings = FALSE)
dir.create(fig_unlabeled, recursive = TRUE, showWarnings = FALSE)

crop_colors <- c(
  wheat   = "#08519C", barley  = "#3182BD", oats    = "#6BAED6", rye     = "#9ECAE1",
  rice    = "#A63603", maize   = "#E6550D", soybean = "#FD8D3C", sorghum = "#FDBE85")
crop_labels <- c(
  wheat = "Wheat", barley = "Barley", oats = "Oats", rye = "Rye",
  rice = "Rice", maize = "Maize", soybean = "Soybean", sorghum = "Sorghum")
COL_BLUE <- "#2166AC"; COL_ORANGE <- "#D35400"

# N cross-check reference (bug-fix safeguard, see header note)
step03_path <- file.path(base_dir, "step03_analysis3_models.xlsx")
step03_n_check <- NULL
if (file.exists(step03_path)) {
  step03_n_check <- as.data.frame(readxl::read_excel(step03_path, sheet = "AdjR2_Wide")) %>%
    dplyr::select(crop, N_M1)   # M1 is full-sample, same N as every full-sample-block model
} else {
  cat("[WARNING] step03_analysis3_models.xlsx not found -- N cross-check will be skipped.\n")
}


# ==============================================================================
# SAVE_PLOT FUNCTION -- identical convention to Steps 01-05
# ==============================================================================

save_plot <- function(g_labeled, plot_name, width = 10, height = 7) {
  g_unlabeled <- g_labeled +
    labs(title = NULL, subtitle = NULL, caption = NULL, x = NULL, y = NULL) +
    theme(legend.title = element_blank(), plot.margin = margin(4, 4, 4, 4))
  cat(sprintf("  [SCREEN] %s -- LABELED\n", plot_name)); print(g_labeled)
  cat(sprintf("  [SCREEN] %s -- UNLABELED\n", plot_name)); print(g_unlabeled)
  save_one <- function(g, dir_path) {
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, ".pdf")),
                    plot = g, width = width, height = height, device = "pdf")
    ggplot2::ggsave(file.path(dir_path, paste0(plot_name, "_1600dpi.png")),
                    plot = g, width = width, height = height, dpi = 1600, device = "png")
  }
  save_one(g_labeled, fig_labeled); save_one(g_unlabeled, fig_unlabeled)
  cat(sprintf("  [SAVED]  %s -> labeled/ + unlabeled/ (PDF + 1600dpi PNG)\n\n", plot_name))
  invisible(NULL)
}


# ==============================================================================
# MAIN LOOP
# ==============================================================================

break_list  <- list()
cd_list     <- list()
hausman_list <- list()

for (crop_name in crop_list) {
  
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) { cat(sprintf("[MISSING] panelv7_%s.xlsx\n", crop_name)); next }
  
  cat("\n", strrep("=", 60), "\n", toupper(crop_name), "\n", strrep("=", 60), "\n")
  
  df_raw <- as.data.frame(readxl::read_excel(f))
  df_raw$Yil <- as.integer(as.character(df_raw$Yil))
  df_raw$ln_yield <- suppressWarnings(log(df_raw$yield_hg_per_ha))
  df_raw$ln_yield[!is.finite(df_raw$ln_yield)] <- NA
  df_raw$IRR <- pmin(pmax(df_raw$irr_ratio, 0), 1)
  df_raw$Country_ISO <- as.character(df_raw$Country_ISO)
  
  # BUG FIX: added !is.na(IRR) and area_harvested_ha > 0 -- must match
  # Step03's full-sample construction exactly (see header note).
  df <- df_raw %>%
    dplyr::filter(!is.na(ln_yield), is.finite(ln_yield), !is.na(TMX_ann), !is.na(PRE_ann),
                  !is.na(IRR),
                  !is.na(area_harvested_ha), area_harvested_ha > 0,
                  !is.na(production_tonnes), production_tonnes > 0)
  TMX_mean <- mean(df$TMX_ann, na.rm = TRUE)
  PRE_mean <- mean(df$PRE_ann, na.rm = TRUE)
  df$TMX_c <- df$TMX_ann - TMX_mean
  df$PRE_c <- df$PRE_ann - PRE_mean
  df$post1990 <- as.integer(df$Yil >= BREAK_YEAR)
  
  cat(sprintf("N = %d | Countries = %d | Pre-1990 obs = %d | Post-1990 obs = %d\n",
              nrow(df), dplyr::n_distinct(df$Country_ISO),
              sum(df$post1990 == 0), sum(df$post1990 == 1)))
  
  # -- N cross-check against Step03 (bug-fix safeguard) ----------------------------
  if (!is.null(step03_n_check)) {
    ref_row <- step03_n_check[step03_n_check$crop == crop_name, ]
    if (nrow(ref_row) > 0) {
      if (nrow(df) != ref_row$N_M1[1]) {
        cat(sprintf("  [WARNING] N mismatch vs Step03! This script: %d | Step03 full sample: %d\n",
                    nrow(df), ref_row$N_M1[1]))
      } else {
        cat(sprintf("  [OK] N matches Step03's full sample exactly (%d).\n", nrow(df)))
      }
    }
  }
  
  
  # ------------------------------------------------------------------------------
  # PART A -- STRUCTURAL BREAK (1990), production-weighted, fixest
  # ------------------------------------------------------------------------------
  
  m_break <- tryCatch(
    fixest::feols(ln_yield ~ TMX_c + PRE_c + TMX_c:post1990 + PRE_c:post1990 | Country_ISO + Yil,
                  data = df, weights = df$production_tonnes, cluster = ~Country_ISO),
    error = function(e) { cat("  [ERROR break model]:", e$message, "\n"); NULL })
  
  if (!is.null(m_break)) {
    cf <- coef(m_break); se <- sqrt(diag(vcov(m_break)))
    pv <- 2 * pnorm(-abs(cf / se))
    
    wald_res <- tryCatch(
      fixest::wald(m_break, keep = "post1990"),
      error = function(e) NULL)
    wald_p <- if (!is.null(wald_res)) wald_res$p else NA_real_
    
    tmx_pre  <- cf["TMX_c"]
    tmx_post <- cf["TMX_c"] + cf["TMX_c:post1990"]
    
    cat(sprintf("TMX pre-1990 = %+.4f | TMX post-1990 = %+.4f | TMX interaction p = %.4f\n",
                tmx_pre, tmx_post, pv["TMX_c:post1990"]))
    cat(sprintf("Joint Wald test (TMX + PRE interactions = 0): p = %.4f %s\n",
                wald_p, ifelse(!is.na(wald_p) && wald_p < 0.05,
                               "(BREAK DETECTED)", "(no significant break)")))
    
    break_list[[crop_name]] <- data.frame(
      crop = crop_name,
      TMX_pre1990 = tmx_pre, TMX_post1990 = tmx_post,
      TMX_interaction_coef = cf["TMX_c:post1990"], TMX_interaction_se = se["TMX_c:post1990"],
      TMX_interaction_p = pv["TMX_c:post1990"],
      PRE_interaction_coef = cf["PRE_c:post1990"], PRE_interaction_p = pv["PRE_c:post1990"],
      joint_wald_p = wald_p,
      break_detected = !is.na(wald_p) && wald_p < 0.05,
      stringsAsFactors = FALSE)
  }
  
  
  # ------------------------------------------------------------------------------
  # PART B -- PESARAN CD TEST (unweighted, plm, two-way FE)
  # ------------------------------------------------------------------------------
  
  pdata <- tryCatch(plm::pdata.frame(df, index = c("Country_ISO", "Yil")),
                    error = function(e) NULL)
  
  cd_stat <- NA_real_; cd_p <- NA_real_
  if (!is.null(pdata)) {
    fe_tw <- tryCatch(
      plm::plm(ln_yield ~ TMX_c + PRE_c, data = pdata, model = "within", effect = "twoways"),
      error = function(e) { cat("  [ERROR plm FE twoways]:", e$message, "\n"); NULL })
    
    if (!is.null(fe_tw)) {
      cd_res <- tryCatch(plm::pcdtest(fe_tw, test = "cd"), error = function(e) NULL)
      if (!is.null(cd_res)) {
        cd_stat <- as.numeric(cd_res$statistic); cd_p <- cd_res$p.value
        cat(sprintf("Pesaran CD test: stat = %.3f, p = %.4f %s\n",
                    cd_stat, cd_p, ifelse(cd_p < 0.05,
                                          "(cross-sectional dependence detected)",
                                          "(no significant cross-sectional dependence)")))
      }
    }
    
    # ------------------------------------------------------------------------------
    # PART C -- HAUSMAN TEST (FE vs RE, country effect only)
    #
    # Uses the standard simplified textbook design: TMX_c + PRE_c only, no
    # year dummies. Including ~55-64 year dummies alongside the individual
    # random effect caused the RE variance-component estimation (Swamy-Arora)
    # to fail for every crop in an earlier version of this test (degenerate/
    # negative variance component) -- a known plm fragility with many time
    # periods. This simplification only affects THIS diagnostic; the
    # substantive models in Step03-05 always use full two-way FE regardless
    # of the Hausman test's outcome.
    # ------------------------------------------------------------------------------
    
    hausman_p <- NA_real_
    fe_c <- tryCatch(
      plm::plm(ln_yield ~ TMX_c + PRE_c, data = pdata, model = "within", effect = "individual"),
      error = function(e) { cat("  [ERROR plm FE individual]:", e$message, "\n"); NULL })
    re_c <- tryCatch(
      plm::plm(ln_yield ~ TMX_c + PRE_c, data = pdata, model = "random", effect = "individual"),
      error = function(e) { cat("  [ERROR plm RE individual]:", e$message, "\n"); NULL })
    
    if (!is.null(fe_c) && !is.null(re_c)) {
      haus_res <- tryCatch(plm::phtest(fe_c, re_c),
                           error = function(e) { cat("  [ERROR phtest]:", e$message, "\n"); NULL })
      if (!is.null(haus_res)) {
        hausman_p <- haus_res$p.value
        cat(sprintf("Hausman test (FE vs RE): stat = %.3f, p = %.4f %s\n",
                    as.numeric(haus_res$statistic), hausman_p,
                    ifelse(hausman_p < 0.05, "(FE preferred)", "(RE not rejected)")))
      }
    }
    
    cd_list[[crop_name]]      <- data.frame(crop = crop_name, cd_stat = cd_stat, cd_p = cd_p,
                                            stringsAsFactors = FALSE)
    hausman_list[[crop_name]] <- data.frame(crop = crop_name, hausman_p = hausman_p,
                                            fe_preferred = !is.na(hausman_p) && hausman_p < 0.05,
                                            stringsAsFactors = FALSE)
  }
  
  rm(df, df_raw, m_break); gc()
}

break_df    <- dplyr::bind_rows(break_list)
cd_df       <- dplyr::bind_rows(cd_list)
hausman_df  <- dplyr::bind_rows(hausman_list)


# ==============================================================================
# CONSOLE SUMMARY
