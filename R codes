cat("STEP 6 -- OUTLIER FLAG (within-country z-score on ln_yield)\n")
cat("Rule: |z_within| > 4 -- extreme observation\n")
cat(strrep("=", 65), "\n\n")

outlier_list <- list()
for (crop_name in names(panel_list)) {
  df <- panel_list[[crop_name]]
  if (!all(c("ln_yield","Country_ISO") %in% names(df))) next
  
  df_flag <- df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(
      lny_mean = mean(ln_yield, na.rm = TRUE),
      lny_sd   = sd(ln_yield,   na.rm = TRUE),
      z_within = (ln_yield - lny_mean) / lny_sd) %>%
    dplyr::ungroup() %>%
    dplyr::filter(!is.na(z_within) & abs(z_within) > 4) %>%
    dplyr::select(Country_ISO, Yil, ln_yield, z_within) %>%
    dplyr::mutate(crop = crop_name)
  
  if (nrow(df_flag) > 0) {
    outlier_list[[crop_name]] <- df_flag
    cat(sprintf("  [%s] %d extreme observations (|z| > 4):\n", crop_name, nrow(df_flag)))
    print(df_flag[order(abs(df_flag$z_within), decreasing = TRUE), ], row.names = FALSE)
    cat("\n")
  } else {
    cat(sprintf("  [%s] No extreme outliers\n", crop_name))
  }
}
